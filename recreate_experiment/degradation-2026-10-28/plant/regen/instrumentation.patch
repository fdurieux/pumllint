+def _regen_dump(got, name):
+    import os, json, math
+    d = os.environ["REGEN_DIR"]
+    doc = json.loads((FIXTURES / "expected" / f"{name}.json").read_text(encoding="utf-8"))
+    got = got.reset_index(drop=True)
+    rows = []
+    for i in range(len(got)):
+        row = []
+        for c in doc["columns"]:
+            v = got[c].iloc[i]; t = doc["dtypes"][c]
+            if t.startswith("datetime64"):
+                row.append(v.isoformat())
+            elif t == "float64":
+                row.append(float(v))
+            elif t in ("int64", "int32"):
+                row.append(int(v))
+            else:
+                row.append(str(v))
+        rows.append(row)
+    doc["data"] = rows
+    with open(os.path.join(d, "frames.jsonl"), "a", encoding="utf-8") as f:
+        f.write(json.dumps({"name": name, "doc": doc}, allow_nan=True) + "\n")
+
