    {
      "id": "claim_848ca9c296224a13b0e3adfd35d02e0a",
      "statement": "`adjust()` is a pure re-derivation: its per-row factor multiplies only split ratios whose effective dates are strictly after the row date, divides raw OHLC prices by the factor, multiplies raw volume by it, copies the input rather than modifying it, and rejects invalid split ratios, non-raw price bases, or missing raw inputs.",
      "evidence": [
        {
          "resource": "repo://src/jef/data/adjust.py#L45-L97",
          "version": "repo-lines-v1:sha256:95df78b875db8ad4444f3dc42c06fe715af157dc2bbddb98a6c73e43e604d428:"
