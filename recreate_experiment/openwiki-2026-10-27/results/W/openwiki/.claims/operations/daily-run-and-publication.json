    {
      "id": "claim_43f34bb01cf246f9ba6785c4b3b12466",
      "statement": "Arguments other than the private `--inner` marker are execed as command overrides; a normal outer invocation re-execs the script under a 3,600-second `timeout` that sends TERM and allows 60 seconds before a hard kill.",
      "evidence": [
        {
          "resource": "repo://deploy/daily.sh#L56-L68",
          "version": "repo-lines-v1:sha256:e0a96b0c506638877223f8a268e57b8b2466dac197c58fced8dc3a998dc22ff5:"
        }
