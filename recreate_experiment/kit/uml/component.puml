@startuml component
title jef.data - modules, the store root and the external systems
package "jef.data (console script jef-data)" {
  component "cli" as Cli
  component "universe" as Universe
  component "sync" as Sync
  component "health" as Health
  component "classification" as Classification
  component "actions" as Actions
  component "adjust" as Adjust
  component "store" as Store
  component "contract" as Contract
  component "differential" as Differential
  component "collectors.base" as CollectorBaseModule
  component "collectors.eodhd" as EodhdModule
  component "collectors.binance" as BinanceModule
  interface "Transport: request(method, url, params) -> (status, text)" as Transport
  component "HttpTransport (requests, 30 s timeout)" as HttpTransport
  component "ReplayTransport (recorded fixtures)" as ReplayTransport
  artifact "universe.toml" as UniverseToml
  artifact "classifications.toml" as ClassificationsToml
}
folder "store root" as StoreRoot {
  folder "market_data/exchange=X/symbol=Y/year=YYYY" as MarketData
  folder "corporate_actions/splits and dividends" as ActionsFiles
}
cloud "EODHD API (eodhd.com/api)" as EodhdApi
cloud "Binance API (api.binance.com)" as BinanceApi
folder "recorded fixtures" as FixtureDir
node "deploy/daily.sh" as DailySh
node "events.sh and dashboard.sh (given externals)" as Externals
node "aws, jef-binning, python3 -m jef.events / jef.dashboard (stubbed)" as ChainStubs
component "downstream seam (outside the program)" as Seam

Cli ..> Universe : load_universe
Cli ..> Sync : run_sync and select_legs
Cli ..> Health : check_source and check_cross_venue
Cli ..> Store : import, export, adjust
Cli ..> Contract : validate
Cli ..> Differential : differential_report
Universe ..> UniverseToml : packaged default
Health ..> Classification : compare
Classification ..> ClassificationsToml : packaged evidence
Sync ..> Actions : sync_actions
Sync ..> Store : reconcile_bars and reapply_adjustment
Sync ..> EodhdModule : get_eod, get_splits, get_dividends
Sync ..> BinanceModule : get_eod
Store ..> Adjust : adjust
Store ..> MarketData : Parquet year files under a lock
Actions ..> ActionsFiles : JSON per symbol
EodhdModule ..> CollectorBaseModule : retries and rate limit
BinanceModule ..> CollectorBaseModule : retries and rate limit
CollectorBaseModule ..> Transport : request through the seam
HttpTransport ..|> Transport : implements
ReplayTransport ..|> Transport : implements
HttpTransport ..> EodhdApi : HTTPS GET
HttpTransport ..> BinanceApi : HTTPS GET
ReplayTransport ..> FixtureDir : reads every *.json except manifest.json
DailySh ..> Cli : jef-data sync and status
DailySh ..> Externals : sources
DailySh ..> ChainStubs : calls
Seam ..> MarketData : reads the exported frame
note bottom of CollectorBaseModule
  transport seam JDL-023; fixture identity JDL-024,
  file JDL-025, replay JDL-026
end note
