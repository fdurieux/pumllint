{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://jdl.example/sync_summary.schema.json",
 "title": "jef-data sync --summary-json document",
 "description": "The per-leg results of one sync run (dry runs included). Written with 1-space indentation, keys sorted, plus a trailing newline. Requirement JDL-106.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema_version", "legs_total", "legs_failed", "revised_cells_total", "ok", "legs"],
 "properties": {
  "schema_version": {"const": 1},
  "legs_total": {"type": "integer", "minimum": 0, "description": "number of leg results (= len(legs))"},
  "legs_failed": {"type": "integer", "minimum": 0, "description": "number of legs with ok = false"},
  "revised_cells_total": {"type": "integer", "minimum": 0, "description": "sum of legs[].revised_cells"},
  "ok": {"type": "boolean", "description": "true exactly when legs_failed = 0; the command exits 0 iff ok"},
  "legs": {
   "type": "array",
   "description": "one entry per selected leg, in selection order",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["asset", "provider", "exchange", "symbol", "ok", "detail", "revised_cells", "revisions"],
    "properties": {
     "asset": {"type": "string"},
     "provider": {"enum": ["eodhd", "binance", "yahoo-csv"]},
     "exchange": {"type": "string", "description": "store partition tag"},
     "symbol": {"type": "string"},
     "ok": {"type": "boolean"},
     "detail": {"type": "string", "description": "the leg detail (sync ritual), 'planned' on a dry run, or '{ExceptionClass}: {message}' on failure"},
     "revised_cells": {"type": "integer", "minimum": 0, "description": "len(revisions)"},
     "revisions": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": ["date", "column", "stored", "served"],
       "properties": {
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "column": {"enum": ["open_raw", "high_raw", "low_raw", "close_raw", "volume_raw", "adjusted_close"]},
        "stored": {"type": "number"},
        "served": {"type": "number"}
       }
      }
     }
    }
   }
  }
 }
}
