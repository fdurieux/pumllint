# Calibration corpus: regenerable via tools/gen_corpus.py; wild/ holds
# third-party diagrams (mixed licenses) harvested by tools/harvest_corpus.py
corpus/

# Codegen experiment artifacts: keep the reports (cited by EVIDENCE.md),
# not the generated throwaway modules
pilot_results/*
!pilot_results/report.json
experiment_results/*
!experiment_results/report.json
!experiment_results/analysis.json
!experiment_results/wave_*/
experiment_results/wave_*/*
!experiment_results/wave_*/report.json
# Agent-repair wave: the repaired diagrams and repair log ARE the treatment —
# keep them for the record, unlike the throwaway generated modules
!experiment_results/wave_repair/repair_log.json
!experiment_results/wave_repair/repaired/
!experiment_results/wave_repair/repaired/**
!experiment_results/wave_repair_author/repair_log.json
!experiment_results/wave_repair_author/repaired/
!experiment_results/wave_repair_author/repaired/**
