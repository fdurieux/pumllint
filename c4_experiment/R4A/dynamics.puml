@startuml loan_origination_dynamics_approved
!include <C4/C4_Sequence>

title Dynamic diagram for LoanCheck - credit check, approved path

Person(applicant, "Loan Applicant")
Container(origination_api, "Origination API", "Python 3.12, FastAPI")
ContainerDb(application_store, "Application Store", "PostgreSQL 16")
Container(decision_engine, "Decision Engine", "Python 3.12, rules library")
System_Ext(credit_bureau, "Credit Bureau")
System_Ext(notification_service, "Notification Service")

Rel(applicant, origination_api, "1: Submits loan application", "JSON/HTTPS")
Rel(origination_api, application_store, "2: [application valid] Stores application as pending", "SQL/TCP")
Rel(origination_api, decision_engine, "3: Requests credit decision", "JSON/HTTPS")
Rel(decision_engine, credit_bureau, "4: Pulls credit report and score", "XML/HTTPS")
Rel(credit_bureau, decision_engine, "5: Returns credit score", "XML/HTTPS")
Rel(decision_engine, origination_api, "6: [score sufficient] Returns approve decision", "JSON/HTTPS")
Rel(origination_api, application_store, "7: Updates application as approved", "SQL/TCP")
Rel(origination_api, notification_service, "8: Sends approval notification", "REST/HTTPS")
Rel(origination_api, applicant, "9: Returns approved response", "JSON/HTTPS")
@enduml

