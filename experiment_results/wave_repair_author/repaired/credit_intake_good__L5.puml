@startuml credit-intake-good--L5
title Credit intake good L5

actor Customer
control CreditEngine
boundary FrontOffice

Customer -> FrontOffice : submitApplication(applicationData)
activate FrontOffice
FrontOffice -> CreditEngine : scoreApplicant(applicationData)
activate CreditEngine
CreditEngine --> FrontOffice : Risk score
deactivate CreditEngine

alt score acceptable
    FrontOffice --> Customer : Offer proposal
else score rejected
    FrontOffice --> Customer : Rejection letter
end
deactivate FrontOffice
@enduml
