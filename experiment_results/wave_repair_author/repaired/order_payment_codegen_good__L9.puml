@startuml order-payment-codegen-good--L9
title Order payment codegen good L9
participant PaymentGateway <<external>>
database OrderDB
participant OrderService

alt order != null
  OrderService -> OrderDB : findOrderById(orderId)
  activate OrderDB
  OrderDB --> OrderService : order
  deactivate OrderDB

  alt order.total > 0
    OrderService -> PaymentGateway : charge(orderId, order.total)
    activate PaymentGateway
    PaymentGateway --> OrderService : receipt
    deactivate PaymentGateway
  else result == paymentError
    PaymentGateway --> OrderService : paymentError
    OrderService ->> OrderService : compensate(orderId)
  end

else order not found
  OrderDB --> OrderService : notFoundError
  deactivate OrderDB
end
@enduml
