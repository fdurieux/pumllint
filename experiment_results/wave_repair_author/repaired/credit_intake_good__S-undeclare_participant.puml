@startuml credit-intake-happy-path
title Credit intake — happy path

actor Customer
participant CreditEngine <<control>>
participant FrontOffice <<boundary>>

Customer -> FrontOffice : submitCreditApplication(applicantId, requestedAmount)
activate FrontOffice
FrontOffice -> CreditEngine : scoreApplicant(applicantId)
activate CreditEngine
CreditEngine --> FrontOffice : Risk score
deactivate CreditEngine

alt score acceptable
    FrontOffice --> Customer : Offer proposal
else score rejected
    FrontOffice --> Customer : Rejection letter
end
deactivate FrontOffice
@enduml
